# LuminTrack environment variables — copy to `.env` and fill in real values.
# `.env` is gitignored. All values below are placeholders.

# ── Database (Neon Postgres) ───────────────────────────────────────────────
# Pooled connection string — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# Direct (non-pooled) connection string — used by `prisma migrate` / the CLI.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# ── Auth ───────────────────────────────────────────────────────────────────
# Session cookie signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-32-byte-random-string"

# ── Vercel Blob (résumé + candidate-document uploads) ──────────────────────
# REQUIRED for uploads. Without BLOB_READ_WRITE_TOKEN every résumé/document
# upload fails silently. Create a Blob store in the Vercel dashboard and copy
# the store id + read/write token here.
BLOB_STORE_ID="store_xxxxxxxxxxxxxxxx"
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ── Seed admin (created by `npm run db:seed`) ──────────────────────────────
SEED_ADMIN_NAME="Admin User"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me"

# ── Error tracking (Sentry — optional) ─────────────────────────────────────
# Sentry stays completely inert until a DSN is set, so these are optional. To
# turn it on: create a project at sentry.io, then set the DSN (same value in
# both — the NEXT_PUBLIC_ one is exposed to the browser). SENTRY_ORG/PROJECT and
# SENTRY_AUTH_TOKEN are only needed if you later enable source-map upload.
# SENTRY_DSN="https://xxxx@oyyyy.ingest.us.sentry.io/zzzz"
# NEXT_PUBLIC_SENTRY_DSN="https://xxxx@oyyyy.ingest.us.sentry.io/zzzz"
# SENTRY_ORG="your-org-slug"
# SENTRY_PROJECT="lumintrack"

# ── Scheduled jobs (Vercel Cron) ───────────────────────────────────────────
# Secret the daily crons authenticate with — the DB backup (/api/cron/backup)
# and the trash purge (/api/cron/purge-trashed-candidates). Vercel sends it as
# `Authorization: Bearer $CRON_SECRET`. If unset, BOTH jobs are disabled (fail
# closed) — no backups are written and trashed candidates are kept until it's set.
# CRON_SECRET="generate-with-openssl-rand-base64-32"

# ── Integration tests (optional) ───────────────────────────────────────────
# Used by `npm run test:integration`. Defaults to the local Docker Postgres
# (see docker-compose.test.yml) when unset.
# DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5433/lumintrack_test"
