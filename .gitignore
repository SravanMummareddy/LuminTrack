# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
.playwright-mcp/

# Playwright E2E — reusable auth sessions + local run artifacts
/e2e/.auth/
/e2e/.results/
/e2e/.report/
/playwright-report/

# agent scratch + local test/review output (committed deliverables in test-results are tracked explicitly)
/test-results/
/scratch-*
*.output

# local screenshot/upload dropbox (iLabor sample is tracked explicitly)
/uploads/*
!/uploads/ilabor_data_sample.json
