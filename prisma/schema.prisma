// LuminTrack — internal recruitment tracking dashboard
// Schema docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  RECRUITER
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum JobPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum JobStatus {
  OPEN
  ON_HOLD
  CLOSED
  FILLED
  CANCELLED
}

// Submission pipeline stage — also the final outcome (no separate outcome field).
enum SubmissionStatus {
  SUBMITTED
  RESUME_PICKED
  VENDOR_SCREENING_CALL
  CLIENT_INTERVIEW
  SELECTED
  REJECTED
  ON_HOLD
  OFFER_RELEASED
  OFFER_ACCEPTED
  JOINED
}

enum InterviewType {
  VENDOR_SCREENING
  CLIENT_INTERVIEW
  MANAGER_ROUND
  HR_ROUND
  FINAL_ROUND
  OTHER
}

enum InterviewResult {
  WAITING
  NEED_ANOTHER_ROUND
  SELECTED
  REJECTED
  ON_HOLD
  COMPLETED
}

// Discriminator for the polymorphic Note and Activity tables.
enum EntityType {
  JOB
  CANDIDATE
  SUBMISSION
  INTERVIEW_ROUND
}

enum ActivityAction {
  JOB_CREATED
  JOB_UPDATED
  RECRUITER_ASSIGNED
  RECRUITER_UNASSIGNED
  CANDIDATE_CREATED
  CANDIDATE_UPDATED
  CANDIDATE_SUBMITTED
  SUBMISSION_STATUS_CHANGED
  SUBMISSION_UPDATED
  INTERVIEW_ROUND_ADDED
  INTERVIEW_RESCHEDULED
  INTERVIEW_RESULT_UPDATED
  FEEDBACK_ADDED
  NOTE_ADDED
  RESUME_UPDATED
  CANDIDATE_SELECTED
  CANDIDATE_REJECTED
  OFFER_RELEASED
  OFFER_ACCEPTED
  CANDIDATE_JOINED
  REQUISITIONS_IMPORTED
  JOB_IMPORTED
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  passwordHash String
  role         UserRole @default(RECRUITER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  jobsCreated       Job[]
  assignments       JobAssignment[]  @relation("AssignmentRecruiter")
  assignmentsMade   JobAssignment[]  @relation("AssignmentAssignedBy")
  candidatesCreated Candidate[]
  submissionsMade   Submission[]
  interviewUpdates  InterviewRound[]
  notes             Note[]
  activities        Activity[]
}

model SisterCompanySource {
  id            String   @id @default(cuid())
  name          String   @unique
  contactPerson String?
  email         String?
  phone         String?
  location      String?
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  jobs     Job[]
  contacts Contact[]
}

// External portals/VMSes we mirror requisitions from (Randstad iLabor, etc.).
// One row per portal; imported Jobs link via Job.portalId + Job.portalRefId.
model JobPortal {
  id        String   @id @default(cuid())
  name      String   @unique
  // Free-text descriptor — "VMS", "Job board", etc. Not driven by any logic.
  kind      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs Job[]
}

model Client {
  id            String   @id @default(cuid())
  name          String   @unique
  contactPerson String?
  email         String?
  phone         String?
  location      String?
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  jobs     Job[]
  contacts Contact[]
}

model Vendor {
  id            String   @id @default(cuid())
  name          String   @unique
  contactPerson String?
  email         String?
  phone         String?
  location      String?
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  jobs     Job[]
  contacts Contact[]
}

// §B1: per-entity contacts. Each row points at exactly one parent via the
// three nullable FKs. A CHECK constraint enforces "exactly one set" — see
// the matching migration. Cascade on parent delete since contacts have no
// independent meaning.
model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  role      String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientId String?
  client   Client?              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  vendorId String?
  vendor   Vendor?              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  sourceId String?
  source   SisterCompanySource? @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([vendorId])
  @@index([sourceId])
}

model Job {
  id            String    @id @default(cuid())
  seq           Int       @unique @default(autoincrement())
  title         String
  location      String?
  vendorRate    Decimal?  @db.Decimal(12, 2)
  candidateRate Decimal?  @db.Decimal(12, 2)
  status        JobStatus @default(OPEN)
  description   String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  clientId              String
  client                Client               @relation(fields: [clientId], references: [id])
  vendorId              String
  vendor                Vendor               @relation(fields: [vendorId], references: [id])
  // Either a managed source (FK) or a free-text source typed on the job — see
  // `sourceOther`. Exactly one is set; `jobSourceLabel()` resolves the display name.
  sisterCompanySourceId String?
  sisterCompanySource   SisterCompanySource? @relation(fields: [sisterCompanySourceId], references: [id])
  sourceOther           String?
  // External portal linkage. portalId points at JobPortal; portalRefId is the
  // portal's own id for this req (e.g. iLabor "requisitionId"). Together they
  // form the upsert key so re-imports update instead of duplicating.
  portalId              String?
  portal                JobPortal?           @relation(fields: [portalId], references: [id])
  portalRefId           String?
  // ─── iLabor-flavored data columns (all nullable — manual jobs ignore these) ──
  atsId                 String?
  startDate             DateTime?
  endDate               DateTime?
  durationLabel         String?
  positions             Int?
  externalSubsCount     Int?
  externalActiveCount   Int?
  releasedDate          DateTime?
  assignedToName        String?
  ownerName             String?
  ownerAltEmail         String?
  reqType               String?
  department            String?
  // §A2: LuminTrack-native job planning fields (not in iLabor either).
  workMode              WorkMode?
  priority              JobPriority?
  targetCloseDate       DateTime?
  postingUrl            String?
  workAuthRequirement   String?
  skills                String[]             @default([])
  externalStatusRaw     String?
  externalCreatedDate   DateTime?
  lastImportedAt        DateTime?
  createdById           String
  createdBy             User                 @relation(fields: [createdById], references: [id])

  assignments JobAssignment[]
  submissions Submission[]
  noteEntries Note[]
  activities  Activity[]

  @@unique([portalId, portalRefId])
  @@index([status])
  @@index([clientId])
  @@index([vendorId])
  @@index([sisterCompanySourceId])
  @@index([portalId])
  @@index([createdAt])
}

// Explicit job <-> recruiter join so assignments can be audited.
model JobAssignment {
  id           String   @id @default(cuid())
  jobId        String
  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  recruiterId  String
  recruiter    User     @relation("AssignmentRecruiter", fields: [recruiterId], references: [id])
  assignedById String?
  assignedBy   User?    @relation("AssignmentAssignedBy", fields: [assignedById], references: [id])
  assignedAt   DateTime @default(now())

  @@unique([jobId, recruiterId])
  @@index([recruiterId])
}

model Candidate {
  id                  String   @id @default(cuid())
  seq                 Int      @unique @default(autoincrement())
  fullName            String
  email               String?
  phone               String?
  currentLocation     String?
  workAuthorization   String?
  totalExperienceYears Decimal? @db.Decimal(4, 1)
  currentCompany      String?
  skills              String[]
  // ≤3 starred skills shown first in list views. Subset of `skills` (enforced
  // in Zod, not at the DB level — Postgres can't express subset constraints
  // cheaply). Empty array means "fall back to first 3 of `skills`."
  featuredSkills      String[]
  linkedinUrl         String?
  resumeBlobUrl       String?
  notes               String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  submissions Submission[]
  resumes     CandidateResume[]
  noteEntries Note[]
  activities  Activity[]

  @@index([email])
  @@index([phone])
  @@index([fullName])
}

// A candidate's saved résumés — one candidate keeps many labelled Drive links,
// and a submission references the one used (see Submission.candidateResume).
model CandidateResume {
  id          String   @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  label       String
  driveLink   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  submissions Submission[]

  @@index([candidateId])
}

model Submission {
  id              String           @id @default(cuid())
  seq             Int              @unique @default(autoincrement())
  status          SubmissionStatus @default(SUBMITTED)
  candidateRate   Decimal?         @db.Decimal(12, 2)
  resumeBlobUrl   String?
  resumeDriveLink String?
  submissionNotes String?
  rejectionReason String?
  submittedAt     DateTime         @default(now())
  // Pipeline tail: §C2. Recorded when the candidate accepts the offer and at
  // actual join time respectively. expectedJoinDate is nullable because not
  // every accepted offer has a confirmed date yet; actualJoinDate is set
  // when status flips to JOINED.
  expectedJoinDate DateTime?
  actualJoinDate   DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  candidateId   String
  candidate     Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId         String
  job           Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  submittedById String
  submittedBy   User      @relation(fields: [submittedById], references: [id])
  // The library résumé chosen for this submission; resumeDriveLink above keeps a
  // snapshot of its link so history survives edits/deletes of the library entry.
  candidateResumeId String?
  candidateResume   CandidateResume? @relation(fields: [candidateResumeId], references: [id], onDelete: SetNull)

  interviewRounds InterviewRound[]
  noteEntries     Note[]
  activities      Activity[]

  @@unique([candidateId, jobId])
  @@index([status])
  @@index([jobId])
  @@index([candidateId])
  @@index([submittedById])
  @@index([candidateResumeId])
  @@index([submittedAt])
}

model InterviewRound {
  id             String          @id @default(cuid())
  roundOrder     Int
  roundName      String
  interviewType  InterviewType
  // How the interview is conducted. `interviewMode` is one of IN_PERSON / PHONE /
  // VIDEO; `interviewPlatform` (Teams / Google Meet / Zoom / Other) is only set
  // when the mode is VIDEO. Plain strings — see INTERVIEW_MODES in src/lib/labels.ts.
  interviewMode     String?
  interviewPlatform String?
  // Optional join URL (Zoom / Teams / Meet / phone bridge). Captured here so
  // recruiters can hand candidates a single click-through instead of digging
  // through email threads.
  meetingLink       String?
  interviewerName String?
  scheduledAt    DateTime?
  result         InterviewResult @default(WAITING)
  feedback       String?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  updatedById  String?
  updatedBy    User?      @relation(fields: [updatedById], references: [id])

  noteEntries Note[]
  activities  Activity[]

  @@index([submissionId])
}

// Polymorphic note — exactly one entity FK is set (matches entityType).
model Note {
  id          String     @id @default(cuid())
  entityType  EntityType
  body        String
  createdAt   DateTime   @default(now())

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  jobId            String?
  job              Job?            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId      String?
  candidate        Candidate?      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  submissionId     String?
  submission       Submission?     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  interviewRoundId String?
  interviewRound   InterviewRound? @relation(fields: [interviewRoundId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([candidateId])
  @@index([submissionId])
  @@index([interviewRoundId])
}

// Polymorphic audit entry — exactly one entity FK is set (matches entityType).
model Activity {
  id          String         @id @default(cuid())
  entityType  EntityType
  action      ActivityAction
  description String
  oldValue    String?
  newValue    String?
  // Optional context captured on a status change: when the event really
  // happened (vs. `createdAt` = when it was recorded), a free-text note, and
  // a preset reason category.
  eventAt     DateTime?
  note        String?
  reason      String?
  createdAt   DateTime       @default(now())

  performedById String
  performedBy   User   @relation(fields: [performedById], references: [id])

  jobId            String?
  job              Job?            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId      String?
  candidate        Candidate?      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  submissionId     String?
  submission       Submission?     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  interviewRoundId String?
  interviewRound   InterviewRound? @relation(fields: [interviewRoundId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([candidateId])
  @@index([submissionId])
  @@index([interviewRoundId])
  @@index([createdAt])
}
