// LuminTrack — internal recruitment tracking dashboard
// Schema docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  MANAGER
  TEAM_LEAD
  RECRUITER
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum JobPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// §B4 — coarse engagement state for a candidate. Independent of `isActive`
// (which is the soft-delete flag). Lets recruiters filter for re-engagement
// vs. people who've asked not to be contacted.
enum CandidateStatus {
  AVAILABLE
  PLACED
  NOT_INTERESTED
  DO_NOT_CONTACT
}

// R4.1 — buckets for the per-candidate document library (beyond résumés).
// Identity + WORK_AUTH are sensitive by convention — see canViewSensitiveDocs
// in src/lib/permissions.ts. EDUCATION + EMPLOYMENT are visible to all recruiters.
enum DocumentCategory {
  IDENTITY
  WORK_AUTH
  EDUCATION
  EMPLOYMENT
  OTHER
}

// C-1 — a résumé is either the candidate's authentic/ORIGINAL résumé or a
// reformatted MARKETING version. A candidate should have an ORIGINAL on file
// before being submitted (soft-gated). Existing rows backfill to ORIGINAL.
enum ResumeKind {
  ORIGINAL
  MARKETING
}

// R4.2 — Placement lifecycle. ACTIVE = currently on assignment; EXTENDED =
// at least one PlacementExtension exists and the parent endDate was bumped;
// ENDED = completed normally; TERMINATED = ended early (incl. JOINED-status
// revert path, which sets endReason=OTHER + endNote).
enum PlacementStatus {
  ACTIVE
  EXTENDED
  ENDED
  TERMINATED
}

enum PlacementEndReason {
  COMPLETED
  TERMINATED_BY_CLIENT
  RESIGNED
  PERFORMANCE
  OTHER
}

enum JobStatus {
  OPEN
  ON_HOLD
  CLOSED
  FILLED
  CANCELLED
}

// Where a job came from. Drives the "Where we found it" section: JOB_BOARD
// carries a board name (learned lookup) + posting URL; REFERRAL points at a
// Referrer; SISTER_COMPANY uses the SisterCompanySource FK; OTHER carries
// free-text `sourceOther`; DIRECT needs no extra detail.
enum JobSourceType {
  JOB_BOARD
  REFERRAL
  SISTER_COMPANY
  DIRECT
  OTHER
}

// Broad discipline of a requisition / bench consultant — IT vs everything else.
// Nullable on both models (existing rows are unclassified until set).
enum Discipline {
  IT
  NON_IT
}

// Submission pipeline stage — also the final outcome (no separate outcome field).
enum SubmissionStatus {
  SUBMITTED
  RESUME_PICKED
  VENDOR_SCREENING_CALL
  CLIENT_INTERVIEW
  SELECTED
  REJECTED
  ON_HOLD
  OFFER_RELEASED
  OFFER_ACCEPTED
  JOINED
  BACKED_OUT
}

enum InterviewType {
  VENDOR_SCREENING
  CLIENT_INTERVIEW
  MANAGER_ROUND
  HR_ROUND
  FINAL_ROUND
  OTHER
}

enum InterviewResult {
  WAITING
  NEED_ANOTHER_ROUND
  SELECTED
  REJECTED
  ON_HOLD
  COMPLETED
}

// Discriminator for the polymorphic Note and Activity tables.
enum EntityType {
  JOB
  CANDIDATE
  SUBMISSION
  INTERVIEW_ROUND
  // Bench-Sales module — bench-consultant roster + its submissions/interviews/
  // placements log against the consultant so the Job timeline stays clean.
  CONSULTANT
  // Vendor Portal Requirement — the pre-submission planning record.
  REQUIREMENT
  // Account/user management + self-service (password change). No entity FK on
  // Activity for these — the target is named in the description.
  USER
}

enum ActivityAction {
  JOB_CREATED
  JOB_UPDATED
  JOB_ERASED
  RECRUITER_ASSIGNED
  RECRUITER_UNASSIGNED
  CANDIDATE_CREATED
  CANDIDATE_UPDATED
  CANDIDATE_CONTACTED
  CANDIDATE_SUBMITTED
  SUBMISSION_STATUS_CHANGED
  SUBMISSION_UPDATED
  INTERVIEW_ROUND_ADDED
  INTERVIEW_RESCHEDULED
  INTERVIEW_RESULT_UPDATED
  FEEDBACK_ADDED
  NOTE_ADDED
  RESUME_ADDED
  RESUME_UPDATED
  RESUME_ARCHIVED
  RESUME_RESTORED
  RESUME_DELETED
  INTERVIEW_ROUND_DELETED
  CANDIDATE_SELECTED
  CANDIDATE_REJECTED
  OFFER_RELEASED
  OFFER_ACCEPTED
  CANDIDATE_JOINED
  REQUISITIONS_IMPORTED
  JOB_IMPORTED
  CANDIDATE_DOCUMENT_ADDED
  CANDIDATE_DOCUMENT_UPDATED
  CANDIDATE_DOCUMENT_REMOVED
  CANDIDATE_STATUS_CHANGED
  PLACEMENT_CREATED
  PLACEMENT_UPDATED
  PLACEMENT_EXTENDED
  PLACEMENT_ENDED
  DATA_EXPORTED
  // Bench-Sales module (logged against the bench consultant).
  BENCH_CONSULTANT_CREATED
  BENCH_CONSULTANT_UPDATED
  BENCH_SUBMISSION_CREATED
  BENCH_SUBMISSION_UPDATED
  BENCH_SUBMISSION_STATUS_CHANGED
  BENCH_INTERVIEW_ADDED
  BENCH_INTERVIEW_UPDATED
  BENCH_PLACEMENT_CREATED
  BENCH_PLACEMENT_UPDATED
  // Vendor Portal Requirement (pre-submission planning layer).
  REQUIREMENT_CREATED
  REQUIREMENT_UPDATED
  REQUIREMENT_CONVERTED
  REQUIREMENT_CANCELLED
  REQUIREMENT_DELETED
  // Account/user management + self-service.
  USER_CREATED
  USER_UPDATED
  USER_PASSWORD_CHANGED
  // Right-to-be-forgotten: candidate personal data erased + files shredded.
  CANDIDATE_ERASED
}

// Bench-Sales roster — marketing priority tier (sheet's "High Priority" /
// "Second Priority" grouping) and the marketing lifecycle state.
enum BenchPriority {
  HIGH
  SECOND
}

enum BenchMarketingStatus {
  ACTIVE
  PAUSED
  PLACED
  INACTIVE
}

// Bench-Sales — engagement model captured on a submission (the sheet's
// "Bench/W2" and "C2C/W2" columns).
enum BenchEngagement {
  C2C
  W2
}

// ─── Models ──────────────────────────────────────────────────────────────────

// ─── Multi-tenancy (Phase C) ─────────────────────────────────────────────────
// The tenant boundary. Every tenant-owned row carries `organizationId`, and the
// central `scopedPrisma(orgId)` extension (src/server/db.ts) injects it on every
// read and write so no query can cross tenants. `Permission` is the sole global
// table (the fixed code catalog). Foundation runs as a single default org;
// onboarding more orgs is additive. A platform super-admin (User.isPlatformAdmin)
// manages orgs across the boundary — see canManageOrganizations in permissions.ts.
model Organization {
  id        String   @id @default(cuid())
  name      String
  // Stable url-safe key (subdomain-ready). Globally unique — orgs are the apex.
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                User[]
  teams                Team[]
  roles                Role[]
  rolePermissions      RolePermission[]
  sisterCompanySources SisterCompanySource[]
  clients              Client[]
  vendors              Vendor[]
  referrers            Referrer[]
  contacts             Contact[]
  jobs                 Job[]
  jobAssignments       JobAssignment[]
  candidates           Candidate[]
  candidateResumes     CandidateResume[]
  candidateDocuments   CandidateDocument[]
  benchConsultants     BenchConsultant[]
  submissions          Submission[]
  placements           Placement[]
  placementExtensions  PlacementExtension[]
  interviewRounds      InterviewRound[]
  supportProviders     SupportProvider[]
  notes                Note[]
  activities           Activity[]
  vendorRequirements   VendorRequirement[]
  lookupOptions        LookupOption[]
  glossaryNotes        GlossaryNote[]
  customGlossaryTerms  CustomGlossaryTerm[]
}

model User {
  id              String       @id @default(cuid())
  organizationId  String       @default("")
  organization    Organization @relation(fields: [organizationId], references: [id])
  fullName        String
  // Login/identity uniques stay GLOBAL for the foundation phase: they resolve
  // before org context exists (login is by email; there is no org selector yet).
  // Making these composite requires org-aware login — a full-multi-org concern.
  email           String       @unique
  passwordHash    String
  role            UserRole     @default(RECRUITER)
  isActive        Boolean      @default(true)
  // Platform super-admin — an orthogonal cross-org axis (like isTeamLead), NOT a
  // per-org role. Gates the Organizations admin surface + cross-tenant actions.
  isPlatformAdmin Boolean      @default(false)
  // Bench-Sales — externally-assigned employee id (e.g. "INC105", "TK2090")
  // shown verbatim on the Monthly Performance scorecard. Nullable + unique
  // (Postgres treats multiple NULLs as distinct, so existing users are fine).
  empId           String?      @unique
  // Org / reporting model (replaced the old free-text `teamLabel`, Wave 1b).
  // `team` = the named team this user belongs to (recruiters + their lead;
  // managers sit above teams → null). `reportsTo` = the self-referential
  // reporting chain: recruiter → team lead → manager → CEO (reportsTo null).
  teamId          String?
  team            Team?        @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  teamsLed        Team[]       @relation("TeamLead")
  reportsToId     String?
  reportsTo       User?        @relation("ReportingChain", fields: [reportsToId], references: [id], onDelete: SetNull)
  reports         User[]       @relation("ReportingChain")
  // Dynamic RBAC (Phase B, expand-contract): the composable role this user is
  // assigned. Coexists with the `role` enum during the transition; `can()` reads
  // the role's permissions, falling back to the enum→template map when unset.
  roleId          String?
  assignedRole    Role?        @relation("UserRoleAssignment", fields: [roleId], references: [id], onDelete: SetNull)
  // Overseers/admins who sit outside the reporting hierarchy (e.g. an owner who
  // silently sees everything) are hidden from the org chart. Defaults true.
  showInOrgChart  Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  jobsCreated                 Job[]
  assignments                 JobAssignment[]      @relation("AssignmentRecruiter")
  assignmentsMade             JobAssignment[]      @relation("AssignmentAssignedBy")
  candidatesCreated           Candidate[]
  submissionsMade             Submission[]
  interviewUpdates            InterviewRound[]
  notes                       Note[]
  activities                  Activity[]
  uploadedDocuments           CandidateDocument[]
  benchConsultantsRecruited   BenchConsultant[]    @relation("BenchConsultantRecruiter")
  benchConsultantsCreated     BenchConsultant[]    @relation("BenchConsultantCreatedBy")
  vendorRequirementsRecruited VendorRequirement[]  @relation("VendorRequirementRecruiter")
  vendorRequirementsCreated   VendorRequirement[]  @relation("VendorRequirementCreatedBy")
  vendorRequirementsConverted VendorRequirement[]  @relation("VendorRequirementConvertedBy")
  glossaryNotes               GlossaryNote[]
  customGlossaryTerms         CustomGlossaryTerm[]
  vendorsRecruited            Vendor[]             @relation("VendorRecruitedBy")
  submissionsResumeWaived     Submission[]         @relation("SubmissionResumeWaivedBy")
  clientsCreated              Client[]              @relation("ClientCreatedBy")
  clientsUpdated              Client[]              @relation("ClientUpdatedBy")
  vendorsCreated              Vendor[]              @relation("VendorCreatedBy")
  vendorsUpdated              Vendor[]              @relation("VendorUpdatedBy")
  sourcesCreated              SisterCompanySource[] @relation("SourceCreatedBy")
  sourcesUpdated              SisterCompanySource[] @relation("SourceUpdatedBy")
  referrersCreated            Referrer[]            @relation("ReferrerCreatedBy")
  referrersUpdated            Referrer[]            @relation("ReferrerUpdatedBy")

  @@index([organizationId])
  @@index([teamId])
  @@index([reportsToId])
  @@index([roleId])
}

// A named team (e.g. "USEI-Sales IT") with a designated team lead. Members are
// recruiters + the lead; the lead is a TEAM_LEAD user. Replaced the free-text
// `User.teamLabel` (Wave 1b). All FKs SetNull so a lead leaving never cascades.
model Team {
  id             String       @id @default(cuid())
  organizationId String       @default("")
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  leadId         String?
  lead           User?        @relation("TeamLead", fields: [leadId], references: [id], onDelete: SetNull)
  members        User[]       @relation("TeamMembers")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([leadId])
}

// Dynamic RBAC (Phase B). Permissions = the fixed code-defined vocabulary
// (mirrors `src/lib/permission-catalog.ts`, seeded); Role = a composable set an
// admin edits in Settings → Roles. `isSystem` roles (Manager/Team Lead/
// Recruiter) can't be deleted/renamed and carry `systemRole` to line up with the
// `User.role` enum during the transition.
//
// Permission is the ONE global (cross-tenant) table — a fixed code catalog every
// org's roles reference. Role/RolePermission are per-org.
model Permission {
  key      String           @id
  label    String
  category String
  roles    RolePermission[]
}

model Role {
  id             String           @id @default(cuid())
  organizationId String           @default("")
  organization   Organization     @relation(fields: [organizationId], references: [id])
  name           String
  label          String
  description    String?
  isSystem       Boolean          @default(false)
  systemRole     UserRole?
  permissions    RolePermission[]
  users          User[]           @relation("UserRoleAssignment")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Per-org uniqueness: each org has its own role set + its own trio of system
  // roles (one Manager/Team Lead/Recruiter per org).
  @@unique([organizationId, name])
  @@unique([organizationId, systemRole])
  @@index([organizationId])
}

model RolePermission {
  organizationId String       @default("")
  organization   Organization @relation(fields: [organizationId], references: [id])
  roleId         String
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionKey  String
  permission     Permission   @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@index([organizationId])
  @@index([permissionKey])
}

model SisterCompanySource {
  id             String       @id @default(cuid())
  organizationId String       @default("")
  organization   Organization @relation(fields: [organizationId], references: [id])
  seq            Int          @unique @default(autoincrement())
  name           String
  contactPerson  String?
  email          String?
  phone          String?
  location       String?
  notes          String?
  isActive       Boolean      @default(true)
  createdById    String?
  createdBy      User?        @relation("SourceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById    String?
  updatedBy      User?        @relation("SourceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  jobs     Job[]
  contacts Contact[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Client {
  id             String       @id @default(cuid())
  organizationId String       @default("")
  organization   Organization @relation(fields: [organizationId], references: [id])
  seq            Int          @unique @default(autoincrement())
  name           String
  contactPerson  String?
  email          String?
  phone          String?
  location       String?
  notes          String?
  isActive       Boolean      @default(true)
  createdById    String?
  createdBy      User?        @relation("ClientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById    String?
  updatedBy      User?        @relation("ClientUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  jobs     Job[]
  contacts Contact[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Vendor {
  id              String       @id @default(cuid())
  organizationId  String       @default("")
  organization    Organization @relation(fields: [organizationId], references: [id])
  seq             Int          @unique @default(autoincrement())
  name            String
  contactPerson   String?
  email           String?
  phone           String?
  location        String?
  notes           String?
  isActive        Boolean      @default(true)
  // "Recruited by" — our team member who owns this vendor relationship. When
  // set, it auto-fills the "Vendor recruiter" on every VPR for this vendor.
  // Either a linked user (recruitedById) OR a free-typed name (recruitedByName)
  // for someone not in the system — never both. Display = user.fullName ?? name.
  recruitedById   String?
  recruitedBy     User?        @relation("VendorRecruitedBy", fields: [recruitedById], references: [id], onDelete: SetNull)
  recruitedByName String?
  createdById     String?
  createdBy       User?        @relation("VendorCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById     String?
  updatedBy       User?        @relation("VendorUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  jobs     Job[]
  contacts Contact[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([recruitedById])
}

// §B1: per-entity contacts. Each row points at exactly one parent via the
// three nullable FKs. A CHECK constraint enforces "exactly one set" — see
// the matching migration. Cascade on parent delete since contacts have no
// independent meaning.
model Contact {
  id             String       @id @default(cuid())
  organizationId String       @default("")
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  email          String?
  phone          String?
  role           String?
  isPrimary      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  clientId String?
  client   Client?              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  vendorId String?
  vendor   Vendor?              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  sourceId String?
  source   SisterCompanySource? @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([clientId])
  @@index([vendorId])
  @@index([sourceId])
}

// A reusable directory of people who refer jobs to us (source rework). A job
// with sourceType REFERRAL points at one Referrer; recruiters pick an existing
// one (contact auto-fills) or quick-add a new one inline, and managers curate
// the full list in Settings › Referrers.
model Referrer {
  id             String       @id @default(cuid())
  organizationId String       @default("")
  organization   Organization @relation(fields: [organizationId], references: [id])
  seq            Int          @unique @default(autoincrement())
  name           String
  email          String?
  phone          String?
  company        String?
  notes          String?
  isActive       Boolean      @default(true)
  createdById    String?
  createdBy      User?        @relation("ReferrerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById    String?
  updatedBy      User?        @relation("ReferrerUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  jobs       Job[]
  candidates Candidate[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Job {
  id             String       @id @default(cuid())
  organizationId String       @default("")
  organization   Organization @relation(fields: [organizationId], references: [id])
  seq            Int          @unique @default(autoincrement())
  title          String
  location       String?
  // Rate chain (top → bottom): clientRate = what the end client releases,
  // vendorRate = the bill rate the vendor releases to us. clientRate is optional
  // ("if available" — often the client's budget isn't disclosed down the vendor
  // chain). Pay/Bill rates for a specific candidate live on the requirement and
  // submission; the Job only carries these requisition-level rates.
  clientRate     Decimal?     @db.Decimal(12, 2)
  vendorRate     Decimal?     @db.Decimal(12, 2)
  status         JobStatus    @default(OPEN)
  description    String?
  notes          String?
  // Lifecycle trash/erase (mirrors Candidate): deletedAt = in trash (hidden,
  // restorable, auto-erases after the retention window); erasedAt = permanently
  // erased tombstone (kept so submissions/analytics survive — an empty job is
  // hard-removed instead of tombstoned). A backup zip is written to Blob first.
  deletedAt      DateTime?
  erasedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  clientId              String
  client                Client               @relation(fields: [clientId], references: [id])
  vendorId              String
  vendor                Vendor               @relation(fields: [vendorId], references: [id])
  // Where this job came from (source rework). `sourceType` selects which detail
  // field applies: JOB_BOARD → `jobBoard` name + `postingUrl`; REFERRAL →
  // `referrerId`; SISTER_COMPANY → `sisterCompanySourceId`; OTHER → `sourceOther`;
  // DIRECT → none. `jobSourceLabel()` resolves the display name.
  sourceType            JobSourceType        @default(OTHER)
  jobBoard              String?
  referrerId            String?
  referrer              Referrer?            @relation(fields: [referrerId], references: [id])
  sisterCompanySourceId String?
  sisterCompanySource   SisterCompanySource? @relation(fields: [sisterCompanySourceId], references: [id])
  sourceOther           String?
  // ─── Optional job-detail fields (all nullable) ──────────────────────────────
  startDate             DateTime?
  // When `startDate` is a recruiter's estimate rather than confirmed. A
  // non-estimated start is required before the job can be Filled/Closed or a
  // placement is created (the estimated-start close-gate).
  startDateEstimated    Boolean              @default(false)
  endDate               DateTime?
  positions             Int?
  workMode              WorkMode?
  priority              JobPriority?
  discipline            Discipline?
  targetCloseDate       DateTime?
  postingUrl            String?
  workAuthRequirement   String?
  skills                String[]             @default([])
  createdById           String
  createdBy             User                 @relation(fields: [createdById], references: [id])

  assignments        JobAssignment[]
  submissions        Submission[]
  placements         Placement[]
  noteEntries        Note[]
  activities         Activity[]
  vendorRequirements VendorRequirement[]

  @@index([organizationId])
  @@index([status])
  @@index([deletedAt])
  @@index([clientId])
  @@index([vendorId])
  @@index([sisterCompanySourceId])
  @@index([referrerId])
  @@index([createdAt])
}

// Explicit job <-> recruiter join so assignments can be audited.
model JobAssignment {
  id             String       @id @default(cuid())
  organizationId String       @default("")
  organization   Organization @relation(fields: [organizationId], references: [id])
  jobId          String
  job            Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  recruiterId    String
  recruiter      User         @relation("AssignmentRecruiter", fields: [recruiterId], references: [id])
  assignedById   String?
  assignedBy     User?        @relation("AssignmentAssignedBy", fields: [assignedById], references: [id])
  assignedAt     DateTime     @default(now())

  @@unique([jobId, recruiterId])
  @@index([organizationId])
  @@index([recruiterId])
}

model Candidate {
  id                      String          @id @default(cuid())
  organizationId          String          @default("")
  organization            Organization    @relation(fields: [organizationId], references: [id])
  seq                     Int             @unique @default(autoincrement())
  // Split name (owner-requested). `fullName` is kept as the derived display value
  // (composed = firstName + " " + lastName on write) so every existing list,
  // search, submission and placement keeps working untouched.
  firstName               String?
  lastName                String?
  fullName                String
  email                   String?
  phone                   String?
  currentLocation         String?
  workAuthorization       String?
  totalExperienceYears    Decimal?        @db.Decimal(4, 1)
  // Actual hands-on experience, distinct from the (often inflated) marketed
  // figure. The bench overlay reads this rather than carrying its own copy.
  realTimeExperienceYears Decimal?        @db.Decimal(4, 1)
  // Single primary focus technology (source of truth; the bench overlay reads
  // this). Usually one of the candidate's skills; free-text so an unlisted tech
  // still works.
  technology              String?
  currentCompany          String?
  skills                  String[]        @default([])
  // ≤3 starred skills shown first in list views. Subset of `skills` (enforced
  // in Zod, not at the DB level — Postgres can't express subset constraints
  // cheaply). Empty array means "fall back to first 3 of `skills`."
  featuredSkills          String[]        @default([])
  linkedinUrl             String?
  resumeBlobUrl           String?
  notes                   String?
  isActive                Boolean         @default(true)
  // §B4 — engagement state (separate from `isActive` soft-delete).
  status                  CandidateStatus @default(AVAILABLE)
  // §E2 — free-form per-candidate labels (e.g. "Hot prospect", "On vacation").
  // Distinct from `skills`. Lowercased + trimmed by the action layer; UI shows
  // as chips.
  tags                    String[]        @default([])
  // §E3 — last-contact timestamp. Bumped explicitly via a "Mark contacted"
  // action; not auto-bumped on every edit (otherwise it'd just mirror
  // updatedAt and lose meaning).
  lastContactedAt         DateTime?
  // §E4 — where this candidate originally came from. Free-text by design
  // (LinkedIn InMail / referral / job-board / inbound / etc.); a fixed enum
  // here would calcify ahead of real usage data.
  source                  String?
  // §D5 — the reference/source as a managed entity, reusing the Jobs Referrer
  // directory (#86). New candidates pick/add a referrer here; the legacy
  // free-text `source` above is kept read-only for old rows.
  referrerId              String?
  referrer                Referrer?       @relation(fields: [referrerId], references: [id], onDelete: SetNull)
  // Broad IT vs Non-IT classification of the person (source of truth; the bench
  // overlay reads this rather than carrying its own copy).
  discipline              Discipline?
  // Is the person currently working anywhere (incl. an external org not placed
  // through us)? Independent of Placement, which tracks only through-us
  // engagements. `workingType` = C2C / W2 / Full-time / free-text (learned).
  isWorking               Boolean         @default(false)
  workingType             String?
  // Soft-delete "trash" marker. Non-null = moved to trash (hidden everywhere,
  // restorable); a scheduled job hard-erases rows past the retention window.
  deletedAt               DateTime?
  // Right-to-be-forgotten marker. Non-null = personal data erased + files
  // shredded; the row is retained (anonymized) so linked submissions/placements
  // keep their history. See hardEraseCandidate.
  erasedAt                DateTime?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  submissions        Submission[]
  resumes            CandidateResume[]
  documents          CandidateDocument[]
  placements         Placement[]
  noteEntries        Note[]
  activities         Activity[]
  // Optional 1:1 back-link from the Bench-Sales roster (see BenchConsultant).
  benchConsultant    BenchConsultant?
  vendorRequirements VendorRequirement[]

  @@index([organizationId])
  @@index([email])
  @@index([phone])
  @@index([fullName])
  @@index([status])
  @@index([deletedAt])
}

// A candidate's saved résumés — one candidate keeps many labelled Drive links,
// and a submission references the one used (see Submission.candidateResume).
model CandidateResume {
  id             String       @id @default(cuid())
  organizationId String       @default("")
  organization   Organization @relation(fields: [organizationId], references: [id])
  candidateId    String
  candidate      Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  label          String
  // C-1 — authentic résumé vs a reformatted marketing version. Defaults to
  // ORIGINAL so existing rows + new uploads are treated as authentic unless the
  // recruiter marks them Marketing.
  kind           ResumeKind   @default(ORIGINAL)
  // Private Vercel Blob upload. `blobPathname` is the key we pass to
  // get(pathname, { access: 'private' }) to stream the file through our own
  // authenticated route (private blobs are never fetched directly by the browser).
  blobPathname   String?
  blobUrl        String?
  sizeBytes      Int?
  contentType    String?
  // Soft-delete: archiving sets this false instead of deleting the row, so
  // submissions keep their live FK link (and their snapshot). Active résumés
  // are the only ones offered in the submit picker; the library can reveal
  // archived ones behind a toggle. True hard-delete is reserved for unused ones.
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  submissions Submission[]

  @@index([organizationId])
  @@index([candidateId, isActive])
}

// R4.1 — per-candidate document vault (passports, work auth, transcripts,
// offer letters, etc.). One row per document; the file itself lives on Google
// Drive and we store a labelled share link, matching CandidateResume. Sensitive
// categories (IDENTITY, WORK_AUTH) are gated on the read path by
// canViewSensitiveDocs (src/lib/permissions.ts). Cascade is defensive — in
// practice candidates are soft-deleted (isActive) so this only fires for true
// admin purges (e.g. seeding cleanup).
model CandidateDocument {
  id             String           @id @default(cuid())
  organizationId String           @default("")
  organization   Organization     @relation(fields: [organizationId], references: [id])
  seq            Int              @unique @default(autoincrement())
  candidateId    String
  candidate      Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  category       DocumentCategory
  label          String
  // Private Vercel Blob upload (PDF/DOCX), gzip-compressed. `blobPathname` is
  // the key we pass to get(pathname, { access: 'private' }); served via the
  // authenticated /api/documents/[id] route (which also enforces the sensitive-
  // category gate). Nullable only so the migration can add them.
  blobPathname   String?
  blobUrl        String?
  sizeBytes      Int?
  contentType    String?
  issuedAt       DateTime?
  expiresAt      DateTime?
  notes          String?
  uploadedById   String
  uploadedBy     User             @relation(fields: [uploadedById], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId])
  @@index([candidateId, category])
  @@index([expiresAt])
}

// Bench-Sales roster — the marketing hotlist of consultants we proactively
// market out to vendors. Owns the "as-marketed" identity + marketing-specific
// fields from the requirements sheet. `candidateId` is an optional 1:1 link to
// the live ATS Candidate, created/attached on first submit; the Candidate is
// what flows into Submission → InterviewRound → Placement. The two are NOT
// kept in sync after linking (this row is the as-marketed snapshot; Candidate
// is the live record) — do not add a mirror-write trigger.
model BenchConsultant {
  id                 String               @id @default(cuid())
  organizationId     String               @default("")
  organization       Organization         @relation(fields: [organizationId], references: [id])
  seq                Int                  @unique @default(autoincrement())
  // Split name mirrors Candidate; `fullName` stays the derived display value.
  // Wired into the bench form in a later PR — columns added now with Candidate's.
  firstName          String?
  lastName           String?
  fullName           String
  email              String?
  phone              String?
  currentLocation    String?
  // Two visa fields per the sheet ("M Visa" / "A Visa") — free-text, since the
  // M/A semantics are unconfirmed. workAuthorization mirrors Candidate's field.
  workAuthorization  String?
  mVisa              String?
  aVisa              String?
  // Two experience figures per the sheet: marketed vs actual real-time.
  marketingExpYears  Decimal?             @db.Decimal(4, 1)
  realTimeExpYears   Decimal?             @db.Decimal(4, 1)
  skills             String[]             @default([])
  reference          String?
  company            String?
  projectType        String?
  // Lowest C2C rate the consultant will accept.
  leastRateC2C       Decimal?             @db.Decimal(12, 2)
  callType           String?
  payrollType        String?
  relocation         Boolean              @default(false)
  // When not open to relocation generally, specific cities they'd still
  // consider (free-text, e.g. "Dallas, Austin").
  relocationCities   String?
  marketingStartDate DateTime?
  // Marketing credentials — gated (canViewBenchCredentials), detail-page only,
  // never a list column or business-export field.
  marketingEmail     String?
  marketingPassword  String?
  marketingNumber    String?
  personalNumber     String?
  priority           BenchPriority        @default(SECOND)
  marketingStatus    BenchMarketingStatus @default(ACTIVE)
  notes              String?
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  // Optional 1:1 link to the live ATS Candidate (created/linked on submit).
  candidateId String?    @unique
  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  // The marketing/sales recruiter who owns this consultant.
  recruiterId String?
  recruiter   User?      @relation("BenchConsultantRecruiter", fields: [recruiterId], references: [id])
  createdById String
  createdBy   User       @relation("BenchConsultantCreatedBy", fields: [createdById], references: [id])

  noteEntries Note[]
  activities  Activity[]

  @@index([organizationId])
  @@index([priority, marketingStatus])
  @@index([recruiterId])
  @@index([marketingStatus])
  @@index([fullName])
  @@index([createdAt])
}

model Submission {
  id                  String           @id @default(cuid())
  organizationId      String           @default("")
  organization        Organization     @relation(fields: [organizationId], references: [id])
  seq                 Int              @unique @default(autoincrement())
  status              SubmissionStatus @default(SUBMITTED)
  // Snapshot of the private-Blob résumé URL used at submit time, so the record
  // survives the library résumé being renamed/archived.
  resumeBlobUrl       String?
  submissionNotes     String?
  rejectionReason     String?
  // Bench-Sales fields (the "Bench Submissions" sheet). Nullable — regular
  // submissions ignore them. Company name is derived from job.client.
  engagement          BenchEngagement?
  vendorRecruiterName String?
  jobDuties           String?
  // Bench/Vendor-Portal rate pair (the sheet's "Pay Rate" / "Bill Rate"):
  // payRate = what we pay the consultant, billRate = what the vendor releases to
  // us (our revenue side). clientRate = what the end client releases (optional —
  // often not disclosed). Separate from candidateRate (the legacy single rate)
  // and nullable so non-bench submissions ignore them. teamLead = sales lead.
  payRate             Decimal?         @db.Decimal(12, 2)
  billRate            Decimal?         @db.Decimal(12, 2)
  clientRate          Decimal?         @db.Decimal(12, 2)
  teamLead            String?
  // §C4 — set when the recruiter consciously submits a duplicate
  // (same candidate already submitted to this job). The DB-level
  // `@@unique([candidateId, jobId])` constraint was dropped so the
  // duplicate check now lives in the action and captures this reason.
  duplicateReason     String?
  submittedAt         DateTime         @default(now())
  // Pipeline tail: §C2. Recorded when the candidate accepts the offer and at
  // actual join time respectively. expectedJoinDate is nullable because not
  // every accepted offer has a confirmed date yet; actualJoinDate is set
  // when status flips to JOINED.
  expectedJoinDate    DateTime?
  actualJoinDate      DateTime?
  // "Résumé not required" waiver — set when a submission is intentionally made
  // without a résumé (marked by the submitter or an admin). While set, the
  // submission drops off the "missing résumé" worklist. Cleared automatically if
  // a résumé is later attached.
  resumeWaivedAt      DateTime?
  resumeWaivedById    String?
  resumeWaivedBy      User?            @relation("SubmissionResumeWaivedBy", fields: [resumeWaivedById], references: [id], onDelete: SetNull)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  candidateId       String
  candidate         Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId             String
  job               Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  submittedById     String
  submittedBy       User             @relation(fields: [submittedById], references: [id])
  // The library résumé chosen for this submission; resumeBlobUrl above keeps a
  // snapshot of its URL so history survives edits/deletes of the library entry.
  candidateResumeId String?
  candidateResume   CandidateResume? @relation(fields: [candidateResumeId], references: [id], onDelete: SetNull)

  interviewRounds     InterviewRound[]
  // R4.2 — the Placement auto-created when this submission moves to JOINED.
  placement           Placement?         @relation("PlacementSubmission")
  // The reverse side of Placement.replacementSubmission — populated when *this*
  // submission was named as the replacement for a terminated placement.
  replacementFor      Placement?         @relation("PlacementReplacement")
  noteEntries         Note[]
  activities          Activity[]
  // The vendor requirement (VPR) this submission was made against, if any. A
  // single VPR can spawn many submissions (recruiters submit several candidates
  // against one requirement) — hence a plain many→one FK, not a 1:1 link.
  vendorRequirementId String?
  vendorRequirement   VendorRequirement? @relation("RequirementSubmissions", fields: [vendorRequirementId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([candidateId, jobId])
  @@index([status])
  @@index([jobId])
  @@index([candidateId])
  @@index([submittedById])
  @@index([candidateResumeId])
  @@index([submittedAt])
  @@index([vendorRequirementId])
  @@index([resumeWaivedById])
}

// R4.2 — a candidate working an assignment. Auto-created when a submission's
// status flips to JOINED (see updateSubmissionStatus). Margin = billRate − payRate.
// Decimal(12, 2) matches Submission.candidateRate / Job.vendorRate so margin math
// doesn't truncate. The submission ↔ placement link is 1:1 (submissionId @unique).
model Placement {
  id                      String               @id @default(cuid())
  organizationId          String               @default("")
  organization            Organization         @relation(fields: [organizationId], references: [id])
  seq                     Int                  @unique @default(autoincrement())
  submissionId            String               @unique
  submission              Submission           @relation("PlacementSubmission", fields: [submissionId], references: [id])
  candidateId             String
  candidate               Candidate            @relation(fields: [candidateId], references: [id])
  jobId                   String
  job                     Job                  @relation(fields: [jobId], references: [id])
  startDate               DateTime
  endDate                 DateTime?
  billRate                Decimal              @default(0) @db.Decimal(12, 2)
  payRate                 Decimal              @default(0) @db.Decimal(12, 2)
  // What the end client releases (optional, carried from the submission). Not
  // part of margin (margin = billRate − payRate), purely informational.
  clientRate              Decimal?             @db.Decimal(12, 2)
  status                  PlacementStatus      @default(ACTIVE)
  endReason               PlacementEndReason?
  endNote                 String?
  // When a placement is ended early and a backfill candidate is identified,
  // we point at *that* submission (same job). Unique because one submission
  // can only be the replacement for one placement.
  replacementSubmissionId String?              @unique
  replacementSubmission   Submission?          @relation("PlacementReplacement", fields: [replacementSubmissionId], references: [id])
  clientPoNumber          String?
  invoiceRef              String?
  onsiteManagerName       String?
  onsiteManagerEmail      String?
  // Bench-Sales sheet fields (June-19 requirements "Placements" tab). All
  // nullable + editable on the placement edit form. `placementDate` defaults to
  // the JOINED date at auto-create; the rest are filled in by the recruiter.
  organisation            String? // implementation / sister company marketing the consultant
  teamLead                String? // "Lead" column on the sheet
  interviewDate           DateTime? // "Date of Interview"
  placementDate           DateTime? // "Date of Placement" (distinct from Start Date)
  remarks                 String?
  extensions              PlacementExtension[]
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  @@index([organizationId])
  @@index([status, endDate])
  @@index([candidateId])
  @@index([jobId])
}

// R4.2 — one row per extension applied to a Placement. The parent's `endDate`
// is bumped to the latest extension's endDate; status flips to EXTENDED on first
// extension. Edit-only (no delete action) per plan — overlap is blocked at the
// Zod layer.
model PlacementExtension {
  id             String       @id @default(cuid())
  organizationId String       @default("")
  organization   Organization @relation(fields: [organizationId], references: [id])
  placementId    String
  placement      Placement    @relation(fields: [placementId], references: [id], onDelete: Cascade)
  startDate      DateTime
  endDate        DateTime
  note           String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([placementId])
}

model InterviewRound {
  id                String           @id @default(cuid())
  organizationId    String           @default("")
  organization      Organization     @relation(fields: [organizationId], references: [id])
  roundOrder        Int
  roundName         String
  interviewType     InterviewType
  // How the interview is conducted. `interviewMode` is one of IN_PERSON / PHONE /
  // VIDEO; `interviewPlatform` (Teams / Google Meet / Zoom / Other) is only set
  // when the mode is VIDEO. Plain strings — see INTERVIEW_MODES in src/lib/labels.ts.
  interviewMode     String?
  interviewPlatform String?
  // Optional join URL (Zoom / Teams / Meet / phone bridge). Captured here so
  // recruiters can hand candidates a single click-through instead of digging
  // through email threads.
  meetingLink       String?
  interviewerName   String?
  scheduledAt       DateTime?
  // §D5 — IANA timezone string (e.g. "America/New_York") the interview is
  // anchored to. `scheduledAt` is UTC; this captures the interviewer's intent
  // so a Pacific scheduler doesn't ship a London candidate Pacific-local time.
  scheduledTimezone String?
  result            InterviewResult  @default(WAITING)
  feedback          String?
  notes             String?
  // Whether this interview was done with external support (the sheet's
  // "Support (Y/N)"). When true, `supportProvider` + `supportMethod` capture
  // who assisted and how.
  supportNeeded     Boolean          @default(false)
  // The external individual who provided support (SetNull so removing a provider
  // never deletes interview history) + a free-text note on how it was given.
  supportProviderId String?
  supportProvider   SupportProvider? @relation(fields: [supportProviderId], references: [id], onDelete: SetNull)
  supportMethod     String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  updatedById  String?
  updatedBy    User?      @relation(fields: [updatedById], references: [id])

  noteEntries Note[]
  activities  Activity[]

  @@index([organizationId])
  @@index([submissionId])
  @@index([supportProviderId])
}

// External people who assist a candidate during an interview (live / proxy
// support). Individuals, not companies — tracked so a recruiter can find one
// by skill and reach out. Linked from InterviewRound.supportProviderId.
model SupportProvider {
  id             String       @id @default(cuid())
  organizationId String       @default("")
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  phone          String?
  email          String?
  // Coarse IT / Non-IT bucket (mirrors Candidate/Job) — narrows the pool before
  // the specific `skills` tags. Optional: a supporter is usually one or neither.
  discipline     Discipline?
  skills         String[]     @default([])
  reference      String?
  notes          String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  interviewRounds InterviewRound[]

  @@index([organizationId])
}

// Polymorphic note — exactly one entity FK is set (matches entityType).
model Note {
  id             String       @id @default(cuid())
  organizationId String       @default("")
  organization   Organization @relation(fields: [organizationId], references: [id])
  entityType     EntityType
  body           String
  createdAt      DateTime     @default(now())

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  jobId             String?
  job               Job?             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId       String?
  candidate         Candidate?       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  submissionId      String?
  submission        Submission?      @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  interviewRoundId  String?
  interviewRound    InterviewRound?  @relation(fields: [interviewRoundId], references: [id], onDelete: Cascade)
  benchConsultantId String?
  benchConsultant   BenchConsultant? @relation(fields: [benchConsultantId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([jobId])
  @@index([candidateId])
  @@index([submissionId])
  @@index([interviewRoundId])
  @@index([benchConsultantId])
}

// Polymorphic audit entry — exactly one entity FK is set (matches entityType).
model Activity {
  id             String         @id @default(cuid())
  organizationId String         @default("")
  organization   Organization   @relation(fields: [organizationId], references: [id])
  entityType     EntityType
  action         ActivityAction
  description    String
  oldValue       String?
  newValue       String?
  // Optional context captured on a status change: when the event really
  // happened (vs. `createdAt` = when it was recorded), a free-text note, and
  // a preset reason category.
  eventAt        DateTime?
  note           String?
  reason         String?
  createdAt      DateTime       @default(now())

  performedById String
  performedBy   User   @relation(fields: [performedById], references: [id])

  jobId             String?
  job               Job?               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId       String?
  candidate         Candidate?         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  submissionId      String?
  submission        Submission?        @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  interviewRoundId  String?
  interviewRound    InterviewRound?    @relation(fields: [interviewRoundId], references: [id], onDelete: Cascade)
  benchConsultantId String?
  benchConsultant   BenchConsultant?   @relation(fields: [benchConsultantId], references: [id], onDelete: Cascade)
  requirementId     String?
  requirement       VendorRequirement? @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([jobId])
  @@index([candidateId])
  @@index([submissionId])
  @@index([interviewRoundId])
  @@index([benchConsultantId])
  @@index([requirementId])
  @@index([createdAt])
}

// Vendor Portal Requirement lifecycle.
enum RequirementStatus {
  OPEN
  CONVERTED
  CANCELLED
}

// Vendor Portal Requirement — a pre-submission *planning* record. A team lead /
// admin pre-decides the commercial terms of a vendor requirement (rates, C2C/W2,
// vendor recruiter, assigned recruiter, optional target candidate); a recruiter
// later "moves it to submission" (convertToSubmission), which creates the real
// Submission and flips this to CONVERTED. Deliberately a SEPARATE table — it is
// invisible to every submission analytic by construction (dashboards, reports,
// scorecard, exports never query it). Distinct from the Job-level iLabor
// "requisition" fields. "Company" is NOT stored — it derives from
// candidate.currentCompany.
model VendorRequirement {
  id             String            @id @default(cuid())
  organizationId String            @default("")
  organization   Organization      @relation(fields: [organizationId], references: [id])
  seq            Int               @unique @default(autoincrement())
  status         RequirementStatus @default(OPEN)

  jobId       String
  job         Job        @relation(fields: [jobId], references: [id], onDelete: Restrict)
  // Optional target candidate (set up front or at convert time).
  candidateId String?
  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  // The marketing/sales recruiter expected to work it.
  recruiterId String?
  recruiter   User?      @relation("VendorRequirementRecruiter", fields: [recruiterId], references: [id])

  // Commercial terms (mirror the Submission bench fields). location is explicit
  // here (the sheet's "Location" column), defaulting from the job at create time.
  location            String?
  payRate             Decimal?         @db.Decimal(12, 2)
  billRate            Decimal?         @db.Decimal(12, 2)
  // What the end client releases (optional — "if available").
  clientRate          Decimal?         @db.Decimal(12, 2)
  engagement          BenchEngagement?
  vendorRecruiterName String?
  jobDuties           String?
  teamLead            String?
  submissionNotes     String?
  // Soft pointer (no FK) to the library résumé to reuse — re-validated at convert.
  candidateResumeId   String?

  // Conversion link — set when moved to a real submission.
  // Submissions made against this requirement (1:many — the VPR stays OPEN and
  // accumulates candidate submissions until a team lead closes it).
  submissions   Submission[] @relation("RequirementSubmissions")
  // Set when a team lead marks the requirement closed (repurposed from the old
  // 1:1 "converted" fields — CONVERTED now means "Closed").
  convertedAt   DateTime?
  convertedById String?
  convertedBy   User?        @relation("VendorRequirementConvertedBy", fields: [convertedById], references: [id])

  createdById String
  createdBy   User     @relation("VendorRequirementCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  activities Activity[]

  @@index([organizationId])
  @@index([status])
  @@index([jobId])
  @@index([candidateId])
  @@index([recruiterId])
}

/// Learned free-text dropdown values — one row per (category, value). A curated
/// static default list (see src/lib/lookups.ts) is unioned with these at read
/// time, and the app upserts a new typed value on save so it reappears next
/// time. Categories: WORK_AUTH, WORKING_TYPE, CALL_TYPE, PAYROLL_TYPE.
/// Per-org: a value typed in one org (often a company name) must not surface in
/// another's dropdowns.
model LookupOption {
  id             String       @id @default(cuid())
  organizationId String       @default("")
  organization   Organization @relation(fields: [organizationId], references: [id])
  category       String
  value          String
  createdAt      DateTime     @default(now())

  @@unique([organizationId, category, value])
  @@index([organizationId])
  @@index([category])
}

/// A user's private note against a glossary term. The term list + definitions
/// are curated in code (src/lib/glossary.ts); this stores only the per-user
/// personalization, keyed by the stable term slug. One note per (user, term).
model GlossaryNote {
  id             String       @id @default(cuid())
  organizationId String       @default("")
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  term           String
  note           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, term])
  @@index([organizationId])
  @@index([userId])
}

/// An org-wide glossary term added manually by an admin/team-lead, on top of
/// the curated code list (src/lib/glossary.ts). Everyone sees it. Soft-deleted
/// (deletedAt) so a term with private notes hanging off its slug can be
/// recovered. `term` is the stable slug the per-user note anchors to.
model CustomGlossaryTerm {
  id             String       @id @default(cuid())
  organizationId String       @default("")
  organization   Organization @relation(fields: [organizationId], references: [id])
  term           String
  label          String
  category       String
  definition     String
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@unique([organizationId, term])
  @@index([organizationId])
  @@index([createdById])
}
